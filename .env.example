# Copy to .env.local and fill in. Without these the app still runs, but reports only
# sync between tabs of one browser.
# Supabase dashboard -> Project Settings -> API Keys (use the publishable key, never the secret one).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only needed for the Supabase CLI (supabase link / db push).
SUPABASE_DB_PASSWORD=
